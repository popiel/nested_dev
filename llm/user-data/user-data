#cloud-config
autoinstall:
  version: 1
  # Power off at end of install, never reboot: with ide2-first boot order a
  # reboot re-enters the installer and reinstalls over the top forever. A
  # parked stopped VM is an unambiguous, pollable completion signal (a
  # mid-install reboot keeps it running and never trips it); the provisioner
  # detaches the installer and boots the disk from there.
  shutdown: poweroff
  locale: en_US.UTF-8
  keyboard: {layout: "us"}
  identity:
    hostname: llm-vm
    username: __PERSONALIZATION_USERNAME__
    password: "CHANGE_ME_HASHED"
    realname: "__PERSONALIZATION_FULLNAME__"
  ssh:
    install-server: true
    allow-pw: false
    # Password auth is disabled above, so key auth is the only way in.
    # Injected by frag/30: the build machine's operator key, plus the
    # install-time guest identity key whose private half lives on the desktop.
    # Dash form: Subiquity's autoinstall schema calls this key
    # `authorized-keys`. The cloud-init underscore form is silently dropped —
    # observed live as an empty list with no error.
    authorized-keys:
      - "__ADMIN_PUBKEY__"
      - "__GUEST_ID_PUBKEY__"
  packages:
    - pciutils
    - linux-firmware
    - curl
    - ca-certificates
    - gnupg
    - qemu-guest-agent
    - net-tools
    - git
  late-commands:
    # UID/GID from personalization.sh — must run before any chown on this user
    - "curtin in-target --target=/target -- usermod -u __PERSONALIZATION_UID__ __PERSONALIZATION_USERNAME__"
    - "curtin in-target --target=/target -- groupmod -g __PERSONALIZATION_GID__ __PERSONALIZATION_USERNAME__"
    # root gets no password: the personalization account is the only login, and
    # root's own credential (keys/root-password-hash) is host-only. subiquity
    # already leaves root locked, but state it explicitly so a later seed
    # change cannot silently introduce a root credential.
    - "curtin in-target --target=/target -- passwd -l root"
    # GPU stack explicitly NOT baked — first boot (llm-firstboot.sh).
    # /data/models mount (filesystem created by host on first attach if blank):
    - "curtin in-target --target=/target -- sh -c 'mkdir -p /data/models /opt/models && (mkfs.ext4 -F /dev/vdb || true) && echo \"/dev/vdb /data/models ext4 defaults,nofail 0 2\" >> /etc/fstab && mount -a || true && ln -sfn /data/models /opt/models'"
    # Enable serial console (access via `qm terminal` from host)
    - "curtin in-target --target=/target -- sh -c 'mkdir -p /etc/systemd/system/serial-getty@ttyS0.service.d && printf \"[Service]\\nExecStart=\\nExecStart=-/sbin/agetty --autologin __PERSONALIZATION_USERNAME__ -o \"-p -f __PERSONALIZATION_USERNAME__\" %%I 115200 linux\\n\" > /etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf'"
    - "curtin in-target --target=/target -- systemctl enable serial-getty@ttyS0"
    # Install first-boot service unit (runs llm-firstboot.sh at boot)
    - "curtin in-target --target=/target -- sh -c 'cat > /etc/systemd/system/llm-firstboot.service << \"UNIT\"\n[Unit]\nDescription=LLM first-boot configuration\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nExecStart=/opt/nested-dev/llm-firstboot.sh\nTimeoutStartSec=1800\nRemainAfterExit=no\n\n[Install]\nWantedBy=multi-user.target\nUNIT\nln -s /etc/systemd/system/llm-firstboot.service /etc/systemd/system/multi-user.target.wants/llm-firstboot.service'"
    # Fetch first-boot script + personalization from GitHub at pinned REF
    - "curtin in-target --target=/target -- sh -c 'mkdir -p /opt/nested-dev && cd /opt/nested-dev && wget -q https://raw.githubusercontent.com/popiel/nested_dev/__GITHUB_REF__/llm/llm-firstboot.sh -O llm-firstboot.sh && wget -q https://raw.githubusercontent.com/popiel/nested_dev/__GITHUB_REF__/provision/personalization.sh -O personalization.sh && chmod +x llm-firstboot.sh && chown __PERSONALIZATION_USERNAME__:__PERSONALIZATION_USERNAME__ llm-firstboot.sh personalization.sh'"
