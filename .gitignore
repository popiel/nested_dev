.idea
.cache
.classpath
.project
/.settings
*.ipr
*.iws
*.iml
.*.swp
.*.swo
# An unanchored `lib/` rule matches tests/lib/ too, which would silently exclude
# tests/lib/helpers.bash — the file every test file loads. Re-include it
# explicitly; the negations must follow the rule they override.
lib/
!/tests/lib/
!/tests/lib/**

# Per-test timing records written by tests/run.sh (tests/timing.sh)
/tests/.timing/
/templates/gen
target/
*/log/*
run/*
!.keep
*.hide
_ajdump/
/project/build.properties
.bloop/
.metals/
.vs/
.vscode/
categories.csv
parts.csv
src/test/resources/*-sorted.csv
src/test/resources/simple/
src/test/resources/pacer/
bricklink_ids.json
nul
/node_modules/
/keys/*
!/keys/*.pub
!/keys/*.asc

# Build output (ISOs, golden images, build artifacts)
/output/*
!/output/.gitkeep

# recovery mined data from failed install sequence
/recovery-ref/
