#!/bin/bash
# tests/e2e/stubs/apt-get — a package manager with the real host's disease.
#
# `apt-get update` fails exactly like the PVE enterprise repository does
# without a subscription (exit 100, 401 on stderr) for as long as the
# enterprise list has an enabled entry, and succeeds once frag/05 has repaired
# it. That ordering is not asserted anywhere in the tests; it emerges from the
# environment. Any fragment — or the bootstrap — that calls apt before the
# repair aborts the run, which is what happens on the real host.
STATE="${E2E_STATE:?E2E_STATE not set}"
ROOT="${PVE_ROOT:?PVE_ROOT not set}"
MOCKBIN="${E2E_MOCKBIN:?E2E_MOCKBIN not set}"
printf 'apt-get %s\n' "$*" >> "$STATE/apt-journal"
case " $* " in
  *" install"*)
    # Installing a package makes its binary appear. Each installed name gets a
    # trivial executable on the mock PATH, so a fragment's post-install
    # `command -v` check observes the effect an install would have.
    for a in "$@"; do
      case "$a" in
        -*|install|update|remove|purge|autoremove) ;;
        *) printf '#!/bin/bash\nexit 0\n' > "$MOCKBIN/$a"
           chmod +x "$MOCKBIN/$a" ;;
      esac
    done
    exit 0
    ;;
esac
case " $* " in
  *" update"*)
    if grep -qE '^[[:space:]]*deb[[:space:]]' \
        "${ROOT}/etc/apt/sources.list.d/pve-enterprise.list" 2>/dev/null; then
      echo "E: Failed to fetch https://enterprise.proxmox.com/debian/pve/dists/trixie/InRelease 401 Unauthorized [IP: 66.70.154.82 443]" >&2
      echo "E: The repository 'https://enterprise.proxmox.com/debian/pve trixie InRelease' is not signed." >&2
      printf 'apt-get %s -> 100\n' "$*" >> "$STATE/apt-journal"
      exit 100
    fi
    ;;
esac
exit 0
