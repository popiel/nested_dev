#!/bin/bash
# tests/e2e/stubs/genisoimage — records the seed build, writes no ISO. The
# seed inputs (user-data, meta-data) are real files asserted separately;
# building the image is genisoimage's job, not the provisioner's.
STATE="${E2E_STATE:?E2E_STATE not set}"
printf 'genisoimage %s\n' "$*" >> "$STATE/journal"
exit 0
