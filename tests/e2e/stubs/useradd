#!/bin/bash
# tests/e2e/stubs/useradd — the account database, as a journal. Every account
# mutation the provisioner performs is asserted from this file, which is what
# "the account exists with these attributes" means without a live user database.
STATE="${E2E_STATE:?E2E_STATE not set}"
printf 'useradd %s\n' "$*" >> "$STATE/account-journal"
exit 0
