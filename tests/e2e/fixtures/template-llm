#cloud-config
# Canned llm user-data for the end-to-end test; same placeholder contract as
# the desktop template.
hostname: e2e-llm
manage_etc_hosts: true
users:
  - name: __PERSONALIZATION_USERNAME__
    gecos: __PERSONALIZATION_FULLNAME__
    uid: __PERSONALIZATION_UID__
    gid: __PERSONALIZATION_GID__
    groups: [adm, sudo]
    lock_passwd: false
    passwd: CHANGE_ME_HASHED
    ssh_authorized_keys:
      - __ADMIN_PUBKEY__
      - __GUEST_ID_PUBKEY__
write_files:
  - path: /home/__PERSONALIZATION_USERNAME__/.ssh/vmctl_ed25519
    content: __VMCTL_PRIV_B64__
    encoding: b64
  - path: /home/__PERSONALIZATION_USERNAME__/.ssh/guest_id_ed25519
    content: __GUEST_ID_PRIV_B64__
    encoding: b64
runcmd:
  - echo "built from __GITHUB_REF__"
