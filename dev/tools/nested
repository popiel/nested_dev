#!/usr/bin/env bash
# nested — wrapper for popiel/nested_dev build toolchain
# Runs inside dev VM (103 dev-nested or similar).
# Binds repo checkout + keys + output from the per-project data volume.
set -euo pipefail

DOCKER_DIR="/opt/dev-docker"
IMAGE="dev-nested-build"
NESTED_DEV="${HOME}/work/nested_dev"

# Ensure repo checkout exists
if [ ! -d "${NESTED_DEV}/.git" ]; then
    echo "[nested] Repository not found at ${NESTED_DEV}."
    echo "  Clone it: git clone https://github.com/popiel/nested_dev.git ${NESTED_DEV}"
    exit 1
fi

# Ensure image exists; build on first use
if ! docker image inspect "${IMAGE}" >/dev/null 2>&1; then
    echo "[nested] Building ${IMAGE} (first run)..."
    docker build --tag "${IMAGE}" -f "${DOCKER_DIR}/Dockerfile.nested" "${DOCKER_DIR}"
fi

# Parse verb
VERB="${1:-help}"
shift 2>/dev/null || true

case "$VERB" in
    build)
        echo "[nested] Building host ISO..."
        docker run --rm \
          -v "${NESTED_DEV}:/work/nested_dev" \
          -w /work/nested_dev \
          -e DEBIAN_FRONTEND=noninteractive \
          "${IMAGE}" \
          -c 'provision/host/build-iso.sh'
        # Normalize ownership of output files (container runs as root)
        chown -R "${USER}:${USER}" "${NESTED_DEV}/output/" 2>/dev/null || true
        chown -R "${USER}:${USER}" "${NESTED_DEV}/keys/" 2>/dev/null || true
        echo "[nested] Build complete. Output in ${NESTED_DEV}/output/"
        ;;

    verify)
        # The committed answer file is a TEMPLATE, not a finished answer file:
        # build-iso.sh renders it from the identity and hash values and is the
        # only thing that can validate it (it needs the rendered passwords and
        # the autoinstall assistant). Printing the template is what this verb
        # can honestly do, so say so instead of implying a validation that
        # did not happen.
        echo "[nested] Answer file template (not rendered — nothing to validate here)"
        echo "[nested] Validation happens during the build: nested build, or"
        echo "        provision/host/build-iso.sh on the host."
        echo
        cat provision/host/answer-host.toml
        ;;

    refresh)
        echo "[nested] Refreshing dev-nested-build image..."
        docker build --pull --no-cache --tag "${IMAGE}" \
          -f "${DOCKER_DIR}/Dockerfile.nested" "${DOCKER_DIR}"
        echo "[nested] Refreshed. New digest:"
        docker inspect --format='{{index .RepoDigests 0}}' "${IMAGE}" 2>/dev/null \
            || echo "  (local only, no registry digest)"
        ;;

    keys-status)
        echo "[nested] Checking keys and hashes..."
        # Both password hashes are required: build-iso.sh reads the root one for
        # the answer file and the personalization one for the first-boot
        # bootstrap and the guest seeds. They live in keys/ — the same
        # gitignored directory the public keys use — not in a separate
        # secrets/ directory, so a check that looks elsewhere reports working
        # credentials as missing and tells the operator to create a second,
        # wrong copy that no build ever reads.
        for secret in personalization-password-hash root-password-hash; do
            if [ -f "${NESTED_DEV}/keys/${secret}" ]; then
                echo "  keys/${secret}: present"
            else
                echo "  keys/${secret}: MISSING"
                echo "    Generate: mkpasswd -m yescrypt > ${NESTED_DEV}/keys/${secret}"
                echo "    (mode 600; keys/* is gitignored, so it stays local)"
            fi
        done
        for key in host_os_ed25519.pub ubuntu-release-key.asc; do
            if [ -f "${NESTED_DEV}/keys/${key}" ]; then
                echo "  keys/${key}: present"
            else
                echo "  keys/${key}: MISSING"
            fi
        done
        ;;

    help|*)
        echo "Usage: nested <command>" >&2
        echo "" >&2
        echo "Commands:" >&2
        echo "  build        Build the host autoinstall ISO" >&2
        echo "  verify       Verify the answer file" >&2
        echo "  refresh      Rebuild the dev-nested-build image from scratch" >&2
        echo "  keys-status  Check that required keys are present" >&2
        echo "  help         Show this help" >&2
        exit 1
        ;;
esac
