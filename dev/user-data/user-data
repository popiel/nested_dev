#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard: {layout: "us"}
  identity:
    hostname: dev-template
    username: __PERSONALIZATION_USERNAME__
    password: "CHANGE_ME_HASHED"
    realname: "__PERSONALIZATION_FULLNAME__"
  ssh:
    install-server: true
    allow-pw: false
  packages:
    - curl
    - ca-certificates
    - gnupg
    - git
    - fakeroot
    - qemu-guest-agent
  late-commands:
    # Set UID/GID to 1401 (§05) — must run before any chown on this user
    - "curtin in-target --target=/target -- usermod -u 1401 __PERSONALIZATION_USERNAME__"
    - "curtin in-target --target=/target -- groupmod -g 1401 __PERSONALIZATION_USERNAME__"
    # Create workspace (project volumes mounted per-clone, not in golden)
    - "curtin in-target --target=/target -- sh -c 'mkdir -p /work && chown __PERSONALIZATION_USERNAME__:__PERSONALIZATION_USERNAME__ /work'"
    # Enable serial console (access via `qm terminal` from host)
    - "curtin in-target --target=/target -- sh -c 'mkdir -p /etc/systemd/system/serial-getty@ttyS0.service.d && printf \"[Service]\\nExecStart=\\nExecStart=-/sbin/agetty --autologin __PERSONALIZATION_USERNAME__ -o \"-p -f __PERSONALIZATION_USERNAME__\" %%I 115200 linux\\n\" > /etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf'"
    - "curtin in-target --target=/target -- systemctl enable serial-getty@ttyS0"
    # Install first-boot service unit (runs dev-firstboot.sh at boot)
    - "curtin in-target --target=/target -- sh -c 'cat > /etc/systemd/system/dev-firstboot.service << \"UNIT\"\n[Unit]\nDescription=Dev first-boot configuration\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nExecStart=/opt/nested-dev/dev-firstboot.sh\nTimeoutStartSec=1800\nRemainAfterExit=no\n\n[Install]\nWantedBy=multi-user.target\nUNIT\nln -s /etc/systemd/system/dev-firstboot.service /etc/systemd/system/multi-user.target.wants/dev-firstboot.service'"
    # Fetch first-boot script + personalization from GitHub at pinned REF
    - "curtin in-target --target=/target -- sh -c 'mkdir -p /opt/nested-dev && cd /opt/nested-dev && wget -q https://raw.githubusercontent.com/popiel/nested_dev/__GITHUB_REF__/dev/dev-firstboot.sh -O dev-firstboot.sh && wget -q https://raw.githubusercontent.com/popiel/nested_dev/__GITHUB_REF__/provision/personalization.sh -O personalization.sh && chmod +x dev-firstboot.sh && chown __PERSONALIZATION_USERNAME__:__PERSONALIZATION_USERNAME__ dev-firstboot.sh personalization.sh'"
