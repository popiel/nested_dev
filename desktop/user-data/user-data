#cloud-config
autoinstall:
  version: 1
  # Power off at end of install like the server seeds: with ide2-first boot
  # order a reboot re-enters the installer and reinstalls over the top
  # forever. The "manual install" era was triage over an undiagnosed
  # wallpaper-sit (almost certainly the same missing-autoinstall-flag
  # prompt), never proof the desktop installer can't run unattended.
  shutdown: poweroff
  locale: en_US.UTF-8
  keyboard: {layout: "us"}
  identity:
    hostname: lychee
    username: __PERSONALIZATION_USERNAME__
    password: "CHANGE_ME_HASHED"
    realname: "__PERSONALIZATION_FULLNAME__"
  ssh:
    install-server: true
    allow-pw: false
    # Password auth is disabled above, so key auth is the only way in.
    # Injected by frag/30: the build machine's operator key, plus the
    # install-time guest identity key whose private half lives on the desktop.
    ssh_authorized_keys:
      - "__ADMIN_PUBKEY__"
      - "__GUEST_ID_PUBKEY__"
  packages:
    # Window manager
    - i3
    - i3status
    - i3blocks
    - dmenu
    - picom
    - lightdm
    # Terminal
    - rxvt-unicode
    # RDP
    - xrdp
    - xorgxrdp
    # Browsers
    - firefox
    # X11 forwarding
    - xauth
    # SSH
    - openssh-client
    - openssh-server
    # Audio
    - pulseaudio
    - pavucontrol
    # Display
    - mesa-utils
    - intel-media-va-driver-non-free
    - xserver-xorg-video-amdgpu
    # System
    - network-manager
    - qemu-guest-agent
    - curl
    - wget
  late-commands:
    # UID/GID from personalization.sh — must run before any chown on this user
    - "curtin in-target --target=/target -- usermod -u __PERSONALIZATION_UID__ __PERSONALIZATION_USERNAME__"
    - "curtin in-target --target=/target -- groupmod -g __PERSONALIZATION_GID__ __PERSONALIZATION_USERNAME__"
    # root gets no password: the personalization account is the only login, and
    # root's own credential (keys/root-password-hash) is host-only. subiquity
    # already leaves root locked, but state it explicitly so a later seed
    # change cannot silently introduce a root credential.
    - "curtin in-target --target=/target -- passwd -l root"
    # Enable lightdm as display manager (symlinks, not systemctl: in-target
    # has no bus, and enable is symlink creation anyway — sibling seeds use
    # ln -s for the same reason (-sf so retries overwrite silently).
    - "curtin in-target --target=/target -- sh -c 'ln -sf /usr/lib/systemd/system/lightdm.service /etc/systemd/system/display-manager.service && ln -sf /usr/lib/systemd/system/graphical.target /etc/systemd/system/default.target'"
    # Configure xrdp to launch i3
    - "curtin in-target --target=/target -- sh -c 'mkdir -p /home/__PERSONALIZATION_USERNAME__/.config && echo \"exec i3\" > /home/__PERSONALIZATION_USERNAME__/.xsession && chmod +x /home/__PERSONALIZATION_USERNAME__/.xsession && chown __PERSONALIZATION_USERNAME__:__PERSONALIZATION_USERNAME__ /home/__PERSONALIZATION_USERNAME__/.xsession'"
    # Enable xrdp (symlink, same reason as above)
    - "curtin in-target --target=/target -- sh -c 'ln -sf /usr/lib/systemd/system/xrdp.service /etc/systemd/system/multi-user.target.wants/xrdp.service'"
    # Enable X11 forwarding in sshd (anchored: stock config has
    # "#X11Forwarding no", which the old pattern never matched — silently
    # leaving the default off while reporting success)
    - "curtin in-target --target=/target -- sed -i \"s/^#X11Forwarding.*/X11Forwarding yes/\" /etc/ssh/sshd_config"
    # Set DNS to host dnsmasq (private network resolver)
    - "curtin in-target --target=/target -- sh -c 'mkdir -p /etc/NetworkManager/conf.d && printf \"[Network]\\nDNS=192.168.100.1\\n\" > /etc/NetworkManager/conf.d/nested-dev.conf'"
    # vmctl control key for dev fleet management (Spec 07)
    # NOTE: late-commands runs in the init stage, which is BEFORE the
    # cloud_config stage where cc_ssh creates ~/.ssh and drops in
    # authorized_keys. So ~/.ssh does not exist yet here and the redirect below
    # would fail with "No such file or directory", silently skipping the
    # chmod/chown behind the &&. mkdir -p is required, not defensive.
    - "curtin in-target --target=/target -- sh -c 'mkdir -p /home/__PERSONALIZATION_USERNAME__/.ssh && chmod 700 /home/__PERSONALIZATION_USERNAME__/.ssh && echo __VMCTL_PRIV_B64__ | base64 -d > /home/__PERSONALIZATION_USERNAME__/.ssh/pvehost_vmctl && chmod 600 /home/__PERSONALIZATION_USERNAME__/.ssh/pvehost_vmctl && chown -R __PERSONALIZATION_USERNAME__:__PERSONALIZATION_USERNAME__ /home/__PERSONALIZATION_USERNAME__/.ssh'"
    # Guest identity private key: the desktop's own credential for reaching the
    # host and the other guests (Spec 07). Same mkdir -p requirement as above.
    - "curtin in-target --target=/target -- sh -c 'mkdir -p /home/__PERSONALIZATION_USERNAME__/.ssh && echo __GUEST_ID_PRIV_B64__ | base64 -d > /home/__PERSONALIZATION_USERNAME__/.ssh/nested-dev-id && chmod 600 /home/__PERSONALIZATION_USERNAME__/.ssh/nested-dev-id && chown __PERSONALIZATION_USERNAME__:__PERSONALIZATION_USERNAME__ /home/__PERSONALIZATION_USERNAME__/.ssh/nested-dev-id'"
    # Install first-boot service unit (runs desktop-firstboot.sh at boot)
    - "curtin in-target --target=/target -- sh -c 'cat > /etc/systemd/system/desktop-firstboot.service << \"UNIT\"\n[Unit]\nDescription=Desktop first-boot configuration\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nExecStart=/opt/nested-dev/desktop-firstboot.sh\nTimeoutStartSec=900\nRemainAfterExit=no\n\n[Install]\nWantedBy=multi-user.target\nUNIT\nln -s /etc/systemd/system/desktop-firstboot.service /etc/systemd/system/multi-user.target.wants/desktop-firstboot.service'"
    # Fetch first-boot script + personalization from GitHub at pinned REF
    - "curtin in-target --target=/target -- sh -c 'mkdir -p /opt/nested-dev && cd /opt/nested-dev && wget -q https://raw.githubusercontent.com/popiel/nested_dev/__GITHUB_REF__/desktop/desktop-firstboot.sh -O desktop-firstboot.sh && wget -q https://raw.githubusercontent.com/popiel/nested_dev/__GITHUB_REF__/provision/personalization.sh -O personalization.sh && chmod +x desktop-firstboot.sh && chown __PERSONALIZATION_USERNAME__:__PERSONALIZATION_USERNAME__ desktop-firstboot.sh personalization.sh'"
